// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Comercio {
  id                  String    @id @default(uuid())
  nombreFantasia      String
  nombreResponsable   String
  apellidoResponsable String
  celular             String?
  email               String    @unique
  activo              Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // Relaciones
  usuarios            Usuario[]
  productos           Producto[]
  movimientosStock    MovimientoStock[]
  ventas              Venta[]
  comprobantes        Comprobante[]
  ventaDetalles       VentaDetalle[]
  gastos              Gasto[]
  proveedores         Proveedor[]
  cotizaciones        CotizacionProveedor[]
  pagosProveedores    PagoProveedor[]
  movimientosCC       MovimientoCuentaCorriente[]
}

model Usuario {
  id               String    @id @default(uuid())
  comercioId       String
  comercio         Comercio  @relation(fields: [comercioId], references: [id])
  email            String    @unique 
  passwordHash     String
  nombre           String?
  rol              Role      @default(CAJERO)
  activo           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  ventasRealizadas         Venta[]
  movimientosRealizados    MovimientoStock[]
  gastosRegistrados        Gasto[]
  cotizacionesRegistradas  CotizacionProveedor[]
  pagosRegistrados         PagoProveedor[]
  movimientosCCRegistrados MovimientoCuentaCorriente[]

  @@index([comercioId])
}

enum Role {
  ADMIN
  CAJERO
}

model Producto {
  id               String    @id @default(uuid())
  comercioId       String
  comercio         Comercio  @relation(fields: [comercioId], references: [id])
  codigoInterno    String
  codigoBarras     String?
  nombre           String
  descripcion      String?
  precioCosto      Decimal?  @db.Decimal(10, 2)
  precioVenta      Decimal   @db.Decimal(10, 2)
  stockActual      Int       @default(0)
  activo           Boolean   @default(true) 
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  movimientos      MovimientoStock[]
  ventasDetalle    VentaDetalle[]

  @@unique([comercioId, codigoInterno])
  @@index([comercioId])
}

model MovimientoStock {
  id               String    @id @default(uuid())
  comercioId       String
  comercio         Comercio  @relation(fields: [comercioId], references: [id])
  productoId       String
  producto         Producto  @relation(fields: [productoId], references: [id])
  usuarioId        String?
  usuario          Usuario?  @relation(fields: [usuarioId], references: [id])
  tipo             TipoMovimientoStock
  cantidad         Int       
  observaciones    String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([comercioId, productoId])
  @@index([comercioId])
}

enum TipoMovimientoStock {
  INGRESO
  VENTA
  AJUSTE_POSITIVO
  AJUSTE_NEGATIVO
}

model Venta {
  id               String    @id @default(uuid())
  comercioId       String
  comercio         Comercio  @relation(fields: [comercioId], references: [id])
  usuarioId        String
  usuario          Usuario   @relation(fields: [usuarioId], references: [id])
  total            Decimal   @db.Decimal(12, 2)
  estado           EstadoVenta @default(COMPLETADA)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  detalles         VentaDetalle[]
  comprobante      Comprobante?

  @@index([comercioId])
  @@index([comercioId, createdAt])
}

enum EstadoVenta {
  COMPLETADA
  ANULADA
}

model VentaDetalle {
  id               String    @id @default(uuid())
  comercioId       String
  comercio         Comercio  @relation(fields: [comercioId], references: [id])
  ventaId          String
  venta            Venta     @relation(fields: [ventaId], references: [id])
  productoId       String?   // null para ítems libres (sin stock)
  producto         Producto? @relation(fields: [productoId], references: [id])
  nombreLibre      String?   // descripción manual para ítems libres
  cantidad         Int
  precioUnitario   Decimal   @db.Decimal(10, 2) 
  precioCosto      Decimal?  @db.Decimal(10, 2) 
  subtotal         Decimal   @db.Decimal(12, 2)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([comercioId, ventaId])
}

model Comprobante {
  id                String    @id @default(uuid())
  comercioId        String
  comercio          Comercio  @relation(fields: [comercioId], references: [id])
  ventaId           String    @unique
  venta             Venta     @relation(fields: [ventaId], references: [id])
  numeroComprobante Int       
  snapshotJSON      Json      
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@unique([comercioId, numeroComprobante])
  @@index([comercioId])
}

model Gasto {
  id            String          @id @default(uuid())
  comercioId    String
  comercio      Comercio        @relation(fields: [comercioId], references: [id])
  usuarioId     String?
  usuario       Usuario?        @relation(fields: [usuarioId], references: [id])
  categoria     CategoriaGasto  @default(OTROS)
  descripcion   String
  monto         Decimal         @db.Decimal(12, 2)
  fecha         DateTime        @default(now())
  metodoPago    String?         // Efectivo, Transferencia, Débito, etc.
  comprobante   String?         // Nro de factura, boleta o referencia
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([comercioId])
  @@index([comercioId, fecha])
}

enum CategoriaGasto {
  PROVEEDORES
  ALQUILER
  SERVICIOS
  INTERNET_TELEFONIA
  SUELDOS
  MANTENIMIENTO
  IMPUESTOS
  OTROS
}

model Proveedor {
  id                  String    @id @default(uuid())
  comercioId          String
  comercio            Comercio  @relation(fields: [comercioId], references: [id])
  nombre              String
  cuit                String?
  telefono            String?
  email               String?
  direccion           String?
  observaciones       String?
  activo              Boolean   @default(true)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  cotizaciones        CotizacionProveedor[]
  pagos               PagoProveedor[]
  movimientos         MovimientoCuentaCorriente[]

  @@index([comercioId])
  @@index([comercioId, activo])
}

model CotizacionProveedor {
  id                  String    @id @default(uuid())
  comercioId          String
  comercio            Comercio  @relation(fields: [comercioId], references: [id])
  proveedorId         String
  proveedor           Proveedor @relation(fields: [proveedorId], references: [id])
  usuarioId           String?
  usuario             Usuario?  @relation(fields: [usuarioId], references: [id])
  numeroComprobante   String    // Número de cotización, factura o remito
  fecha               DateTime  @default(now())
  montoTotal          Decimal   @db.Decimal(12, 2)
  montoPagado         Decimal   @db.Decimal(12, 2) @default(0)
  estado              EstadoCotizacion @default(PENDIENTE)
  observaciones       String?
  archivoUrl          String?   @db.Text
  archivoNombre       String?
  anulado             Boolean   @default(false)
  anuladoMotivo       String?
  anuladoAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  movimiento          MovimientoCuentaCorriente?
  pagosAsociados      PagoCotizacion[]

  @@index([comercioId, proveedorId])
  @@index([comercioId, fecha])
}

enum EstadoCotizacion {
  PENDIENTE
  PARCIAL
  PAGADA
  ANULADA
}

model PagoProveedor {
  id                  String    @id @default(uuid())
  comercioId          String
  comercio            Comercio  @relation(fields: [comercioId], references: [id])
  proveedorId         String
  proveedor           Proveedor @relation(fields: [proveedorId], references: [id])
  usuarioId           String?
  usuario             Usuario?  @relation(fields: [usuarioId], references: [id])
  fecha               DateTime  @default(now())
  monto               Decimal   @db.Decimal(12, 2)
  medioPago           MedioPagoProveedor @default(EFECTIVO)
  referencia          String?
  observaciones       String?

  // Comprobante de pago propio (ej. transferencia bancaria)
  comprobantePagoUrl    String?   @db.Text
  comprobantePagoNombre String?

  // Control independiente de recibo del proveedor
  reciboRecibido      Boolean   @default(false)
  reciboNumero        String?
  reciboFecha         DateTime?
  reciboArchivoUrl    String?   @db.Text
  reciboArchivoNombre String?

  // Datos específicos de medios de pago
  transferenciaBanco      String?
  transferenciaOperacion  String?
  transferenciaFecha      DateTime?

  chequeNumero        String?
  chequeBanco         String?
  chequeFechaEmision  DateTime?
  chequeFechaCobro    DateTime?
  chequeEstado        EstadoCheque?

  estado              EstadoPagoProveedor @default(CONFIRMADO)
  anuladoMotivo       String?
  anuladoAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  movimiento          MovimientoCuentaCorriente?
  cotizacionesAsociadas PagoCotizacion[]

  @@index([comercioId, proveedorId])
  @@index([comercioId, reciboRecibido])
  @@index([comercioId, fecha])
}

enum MedioPagoProveedor {
  EFECTIVO
  TRANSFERENCIA
  CHEQUE
  DEBITO
  CREDITO
  OTRO
}

enum EstadoCheque {
  PENDIENTE
  ACREDITADO
  RECHAZADO
}

enum EstadoPagoProveedor {
  CONFIRMADO
  ANULADO
}

model PagoCotizacion {
  id                  String    @id @default(uuid())
  pagoId              String
  pago                PagoProveedor @relation(fields: [pagoId], references: [id], onDelete: Cascade)
  cotizacionId        String
  cotizacion          CotizacionProveedor @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)
  montoAsignado       Decimal   @db.Decimal(12, 2)
  createdAt           DateTime  @default(now())

  @@index([pagoId])
  @@index([cotizacionId])
}

model MovimientoCuentaCorriente {
  id                  String    @id @default(uuid())
  comercioId          String
  comercio            Comercio  @relation(fields: [comercioId], references: [id])
  proveedorId         String
  proveedor           Proveedor @relation(fields: [proveedorId], references: [id])
  usuarioId           String?
  usuario             Usuario?  @relation(fields: [usuarioId], references: [id])
  fecha               DateTime  @default(now())
  tipo                TipoMovimientoCC
  concepto            String
  comprobante         String?
  monto               Decimal   @db.Decimal(12, 2)
  saldoResultante     Decimal?  @db.Decimal(12, 2)

  cotizacionId        String?   @unique
  cotizacion          CotizacionProveedor? @relation(fields: [cotizacionId], references: [id], onDelete: Cascade)

  pagoId              String?   @unique
  pago                PagoProveedor? @relation(fields: [pagoId], references: [id], onDelete: Cascade)

  anulado             Boolean   @default(false)
  anuladoMotivo       String?
  anuladoAt           DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([comercioId, proveedorId])
  @@index([comercioId, proveedorId, fecha])
}

enum TipoMovimientoCC {
  DEBITO
  CREDITO
}

